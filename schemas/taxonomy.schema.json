{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taxonomy.schema.json",
  "title": "Question-type taxonomy for one paper (papers/p<N>/taxonomy.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "version", "chapters", "types"],
  "properties": {
    "component": {"type": "integer", "enum": [1, 2, 3, 4]},
    "version": {"type": "string"},
    "chapters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "name_zh", "name_en", "syllabus"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z]{2,3}$"},
          "name_zh": {"type": "string"},
          "name_en": {"type": "string"},
          "syllabus": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"}, "description": "Syllabus section numbers, e.g. 8.1"}
        }
      }
    },
    "types": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "chapter", "name_zh", "summary"],
        "properties": {
          "code": {"type": "string", "pattern": "^P[1-4]-[A-Z]{2,3}-[0-9]{2}$"},
          "chapter": {"type": "string", "pattern": "^[A-Z]{2,3}$"},
          "name_zh": {"type": "string"},
          "name_en": {"type": "string"},
          "summary": {"type": "string", "description": "One line: what this type asks, as a tagging guide"},
          "cues": {"type": "array", "items": {"type": "string"}, "description": "Recognition cues (wording/patterns) used by taggers"},
          "not": {"type": "array", "items": {"type": "string"}, "description": "Near-miss types this must not be confused with (codes) and why"},
          "syllabus": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
